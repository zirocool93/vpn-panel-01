# Unignore specific files
!README.MD
!.gitignore

# Explicitly ignore these (redundant due to * but good for clarity/overrides if I change * later)
config.py
logs/
tests/
docs/
results.md
AGENTS.md
.agents/
tmp/
**/__pycache__/
.vscode
.claude/

# База данных (создаётся автоматически при запуске)
database/vpn_bot.db
database/vpn_bot.db-*

# Локальные бэкапы (создаются автоматически планировщиком)
/backup/
/backups/
*.tar.gz

# Virtual Environment
venv/
env/
.venv/
.env/
env*/
venv*/
.env
