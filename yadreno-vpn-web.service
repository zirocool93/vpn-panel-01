[Unit]
Description=Yadreno VPN Web Admin
After=network.target

[Service]
Type=simple
# TODO: Prefer a dedicated unprivileged user (for example yadreno) after install.sh is migrated away from root.
User=root
WorkingDirectory=/root/vpn-panel-01
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=8080
ExecStart=/root/vpn-panel-01/venv/bin/python web_main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

